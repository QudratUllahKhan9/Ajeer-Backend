# ---------- Vercel > Project > Settings > Environment Variables ----------
# MongoDB Atlas connection string (local mongodb:// Vercel par kaam nahi karega)
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ajeer?retryWrites=true&w=majority

# QR ke andar yahi host + id jata hai  ->  <PUBLIC_BASE_URL>/v/<id>
# Vercel par apne backend ka domain: https://ajeer-api.vercel.app
PUBLIC_BASE_URL=https://ajeer-api.vercel.app

# scan -> 302 -> <FRONTEND_URL>/v/<same id>
FRONTEND_URL=https://ajeer-qiwa-sa-five.vercel.app

# redirect = 302 frontend par (default) | page = backend khud HTML banaye
REDIRECT_MODE=redirect

# CORS allow-list (comma separated, no spaces)
WEB_ORIGIN=http://localhost:5173,https://ajeer-qiwa-sa-five.vercel.app

# domain-change API ka token
ADMIN_TOKEN=change-me

# (optional) local dev par port; Vercel ignore karta hai
PORT=4000
